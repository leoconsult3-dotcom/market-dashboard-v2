<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Swing Trading Dashboard Pro</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js" crossorigin="anonymous"></script>
<script>
// Fallback if jsDelivr is blocked
(function() {
  function loadScript(src, cb) {
    var s = document.createElement('script');
    s.src = src;
    s.onload = cb;
    s.onerror = function() { console.warn('Failed to load', src); if (cb) cb(new Error('load failed')); };
    document.head.appendChild(s);
  }
  window.__ensureChart = function(cb) {
    if (typeof Chart !== 'undefined') { cb(); return; }
    loadScript('https://unpkg.com/chart.js@4.4.1/dist/chart.umd.min.js', function() {
      loadScript('https://unpkg.com/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js', cb);
    });
  };
})();
</script>
<style>
  :root {
    --bg: #0d1117; --card: #161b22; --border: #30363d; --text: #e6edf3;
    --muted: #8b949e; --blue: #58a6ff; --green: #3fb950; --red: #f85149;
    --orange: #f0883e; --purple: #a371f7; --cyan: #39c5cf;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg); color: var(--text); padding: 18px; line-height: 1.5; min-height: 100vh;
  }
  .topbar {
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--border);
  }
  .topbar h1 { font-size: 1.3rem; font-weight: 600; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  select, input, button {
    background: var(--card); border: 1px solid var(--border); color: var(--text);
    padding: 8px 11px; border-radius: 8px; font-size: 0.87rem;
  }
  select { min-width: 150px; cursor: pointer; }
  input[type="password"], input[type="text"] { min-width: 170px; }
  button { background: #238636; border-color: #238636; cursor: pointer; font-weight: 600; }
  button:hover { background: #2ea043; }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .status { font-size: 0.8rem; color: var(--muted); }
  .grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px; margin-bottom: 16px;
  }
  .card {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px;
  }
  .card h3 {
    font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--muted); margin-bottom: 4px;
  }
  .card .value { font-size: 1.25rem; font-weight: 600; }
  .card .sub { color: var(--muted); font-size: 0.76rem; margin-top: 2px; }
  .bias-pill {
    display: inline-block; padding: 3px 10px; border-radius: 16px; font-weight: 600; font-size: 0.86rem;
  }
  .bias-long { background: #3fb95022; color: var(--green); border: 1px solid #3fb95055; }
  .bias-short { background: #f8514922; color: var(--red); border: 1px solid #f8514955; }
  .bias-neutral { background: #f0883e22; color: var(--orange); border: 1px solid #f0883e55; }
  .section {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 14px 16px; margin-bottom: 16px;
  }
  .section h2 {
    font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); margin-bottom: 10px;
  }
  .chart-wrap {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px; margin-bottom: 16px; height: 460px; position: relative;
  }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  th, td { padding: 6px 7px; text-align: left; border-bottom: 1px solid #21262d; }
  th { color: var(--muted); font-weight: 500; font-size: 0.68rem; text-transform: uppercase; }
  .liq-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px;
  }
  .liq-item label { display: block; font-size: 0.65rem; text-transform: uppercase; color: var(--muted); }
  .liq-item .val { font-size: 1.05rem; font-weight: 600; }
  .trade-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 8px;
  }
  .trade-item label { display: block; font-size: 0.65rem; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .trade-item .val { font-size: 1.15rem; font-weight: 600; }
  .entry { color: var(--blue); } .stop { color: var(--red); }
  .target { color: var(--green); } .rr { color: var(--orange); }
  .ai-box {
    background: linear-gradient(135deg, #161b22 0%, #1a2332 100%);
    border: 1px solid #30363d; border-left: 3px solid var(--purple);
    border-radius: 8px; padding: 12px 14px; margin-top: 10px; font-size: 0.9rem; color: #c9d1d9;
  }
  .news-links a {
    display: inline-block; margin: 4px 6px 4px 0; padding: 5px 10px;
    background: #21262d; border-radius: 6px; color: var(--blue); text-decoration: none; font-size: 0.82rem;
  }
  .news-links a:hover { background: #30363d; }
  .notes ul { padding-left: 18px; color: #c9d1d9; }
  .notes li { margin-bottom: 4px; }
  .disclaimer {
    margin-top: 20px; padding: 10px; background: #21262d; border-radius: 8px;
    font-size: 0.74rem; color: var(--muted); text-align: center;
  }
  .loading { opacity: 0.4; pointer-events: none; }
  .error {
    background: #f8514922; border: 1px solid #f8514955; color: var(--red);
    padding: 10px 14px; border-radius: 8px; margin-bottom: 12px; display: none;
  }
  .tag {
    display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: 0.72rem;
    background: #21262d; color: var(--muted); margin-right: 4px;
  }
  .legend-hint {
    font-size: 0.75rem; color: var(--muted); margin-top: 6px;
  }
  .legend-hint span { margin-right: 12px; }

  /* Loading & Error UX */
  .spinner {
    display: inline-block; width: 16px; height: 16px;
    border: 2px solid #30363d; border-top-color: #58a6ff;
    border-radius: 50%; animation: spin 0.7s linear infinite;
    vertical-align: middle; margin-right: 8px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .loading-overlay {
    position: absolute; inset: 0; background: rgba(13,17,23,0.65);
    display: flex; align-items: center; justify-content: center;
    border-radius: 10px; z-index: 10; font-size: 0.95rem; color: var(--text);
  }
  .loading-overlay.hidden { display: none; }
  .error {
    background: #f8514922; border: 1px solid #f8514955; color: #ff7b72;
    padding: 12px 16px; border-radius: 8px; margin-bottom: 14px;
    display: none; align-items: flex-start; gap: 12px;
  }
  .error.visible { display: flex; }
  .error .err-body { flex: 1; }
  .error .err-title { font-weight: 600; margin-bottom: 4px; }
  .error .err-detail { font-size: 0.85rem; opacity: 0.9; }
  .error button {
    background: #21262d; border: 1px solid #30363d; color: var(--text);
    padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 0.82rem;
    white-space: nowrap;
  }
  .error button:hover { background: #30363d; }
  .status-ok { color: var(--green); }
  .status-err { color: var(--red); }
</style>
</head>
<body>
  <div class="topbar">
    <div>
      <h1>Swing Trading Dashboard Pro</h1>
      <div class="status" id="timestamp">Ready — select symbol &amp; analyze</div>
    </div>
    <div class="controls">
      <select id="symbolSelect">
        <optgroup label="US Indices / ETFs">
          <option value="SPY">SPY — S&amp;P 500</option>
          <option value="QQQ">QQQ — Nasdaq 100</option>
          <option value="IWM">IWM — Russell 2000</option>
          <option value="DIA">DIA — Dow</option>
          <option value="XLF">XLF — Financials</option>
          <option value="XLE">XLE — Energy</option>
          <option value="XLK">XLK — Tech</option>
          <option value="GLD">GLD — Gold</option>
          <option value="SLV">SLV — Silver</option>
          <option value="TLT">TLT — Bonds</option>
        </optgroup>
        <optgroup label="Mega Cap">
          <option value="AAPL">AAPL</option><option value="MSFT">MSFT</option>
          <option value="NVDA">NVDA</option><option value="GOOGL">GOOGL</option>
          <option value="AMZN">AMZN</option><option value="META">META</option>
          <option value="TSLA">TSLA</option><option value="AMD">AMD</option>
          <option value="AVGO">AVGO</option>
        </optgroup>
        <optgroup label="Other Stocks">
          <option value="JPM">JPM</option><option value="V">V</option>
          <option value="BAC">BAC</option><option value="XOM">XOM</option>
          <option value="COST">COST</option><option value="NFLX">NFLX</option>
          <option value="BA">BA</option><option value="GS">GS</option>
        </optgroup>
        <optgroup label="Crypto">
          <option value="BTC/USD">BTC/USD</option><option value="ETH/USD">ETH/USD</option>
          <option value="SOL/USD">SOL/USD</option><option value="XRP/USD">XRP/USD</option>
        </optgroup>
        <optgroup label="Forex &amp; Metals">
          <option value="EUR/USD">EUR/USD</option><option value="GBP/USD">GBP/USD</option>
          <option value="USD/JPY">USD/JPY</option><option value="XAU/USD">XAU/USD Gold</option>
          <option value="XAG/USD">XAG/USD Silver</option>
        </optgroup>
      </select>
      <select id="tfSelect" title="Chart timeframe">
        <option value="15min">15m</option>
        <option value="1h">1H</option>
        <option value="4h" selected>4H</option>
        <option value="1day">Daily</option>
      </select>
      <select id="dataSource" title="Data provider">
        <option value="finnhub" selected>Finnhub — only</option>
      </select>
      <input type="text" id="customSymbol" placeholder="Custom symbol" style="min-width:120px" />
      <input type="password" id="apiKey" placeholder="API key" style="min-width:160px" />
      <button id="runBtn" onclick="runAnalysis()">Analyze</button>
      <button type="button" id="testBtn" onclick="testConnection()" style="background:#1f6feb;border-color:#1f6feb">Test Connection</button>
      <span class="status" id="connStatus"></span>
    </div>
  </div>

  <div class="error" id="errorBox">
    <div class="err-body">
      <div class="err-title" id="errTitle">Something went wrong</div>
      <div class="err-detail" id="errDetail"></div>
    </div>
    <button onclick="runAnalysis()">Retry</button>
  </div>

  <div id="dashboard" class="loading">
    <div class="grid">
      <div class="card"><h3>Last Price</h3><div class="value" id="price">—</div><div class="sub" id="priceSub">—</div></div>
      <div class="card"><h3>SMA 200</h3><div class="value" id="sma">—</div><div class="sub" id="smaSub">—</div></div>
      <div class="card"><h3>Daily RSI</h3><div class="value" id="rsiD">—</div><div class="sub" id="rsiDSub">—</div></div>
      <div class="card"><h3>Weekly RSI</h3><div class="value" id="rsiW">—</div><div class="sub">HTF momentum</div></div>
      <div class="card"><h3>HTF Bias</h3><div class="value"><span class="bias-pill bias-neutral" id="bias">—</span></div><div class="sub">SMA + Weekly RSI</div></div>
    </div>

    <div class="section">
      <h2>Liquidity Areas — PDH / PDL / Classic Pivots</h2>
      <div class="liq-grid">
        <div class="liq-item"><label>PDH</label><div class="val" id="pdh">—</div></div>
        <div class="liq-item"><label>PDL</label><div class="val" id="pdl">—</div></div>
        <div class="liq-item"><label>Pivot</label><div class="val" id="pivot">—</div></div>
        <div class="liq-item"><label>R1</label><div class="val" id="r1">—</div></div>
        <div class="liq-item"><label>R2</label><div class="val" id="r2">—</div></div>
        <div class="liq-item"><label>S1</label><div class="val" id="s1">—</div></div>
        <div class="liq-item"><label>S2</label><div class="val" id="s2">—</div></div>
        <div class="liq-item"><label>Nearest</label><div class="val" id="nearestLiq" style="color:var(--cyan)">—</div></div>
      </div>
    </div>

    <div class="section">
      <h2>ICT-style context (4H)</h2>
      <div class="liq-grid" style="margin-bottom:8px">
        <div class="liq-item"><label>Last sweep (4H)</label><div class="val" id="ictSweep">—</div></div>
        <div class="liq-item"><label>Displacement (4H)</label><div class="val" id="ictDisp">—</div></div>
        <div class="liq-item"><label>Structure (4H)</label><div class="val" id="ictStruct">—</div></div>
        <div class="liq-item"><label>Alignment</label><div class="val" id="ictAlign">—</div></div>
      </div>
      <div class="ai-box" id="ictNote" style="border-left-color:var(--cyan)">Sweep + displacement on 4H bars. Confirm exact entries on TradingView 15m/1H.</div>
    </div>

    <div class="section">
      <h2>AI Swing Idea (also plotted on chart)</h2>
      <div id="tradeDirection" style="font-size:1.05rem;font-weight:600;margin-bottom:6px;">—</div>
      <div class="trade-grid">
        <div class="trade-item"><label>Entry Zone</label><div class="val entry" id="entryZone">—</div></div>
        <div class="trade-item"><label>Stop / Invalidation</label><div class="val stop" id="stopLevel">—</div></div>
        <div class="trade-item"><label>Target 1</label><div class="val target" id="target1">—</div></div>
        <div class="trade-item"><label>Target 2</label><div class="val target" id="target2">—</div></div>
        <div class="trade-item"><label>Risk : Reward</label><div class="val rr" id="rrRatio">—</div></div>
      </div>
      <div class="ai-box" id="aiIdea">Select a symbol and click Analyze.</div>
      <div class="legend-hint">
        <span style="color:#58a6ff">━━ Entry</span>
        <span style="color:#f85149">━━ Stop</span>
        <span style="color:#3fb950">━━ Target</span>
        <span style="color:#8b949e">··· PDH/PDL/Pivot</span>
      </div>
    </div>

    <div class="chart-wrap" style="position:relative">
      <div class="loading-overlay hidden" id="chartLoading">
        <span class="spinner"></span> Fetching market data…
      </div>
      <canvas id="mainChart"></canvas>
    </div>

    <div class="two-col">
      <div class="card">
        <h3 style="margin-bottom:8px">Recent ZigZag Swings</h3>
        <table><thead><tr><th>Date</th><th>Type</th><th>Price</th></tr></thead><tbody id="pivotBody"></tbody></table>
      </div>
      <div class="card">
        <h3 style="margin-bottom:8px">Fibonacci Levels</h3>
        <table><thead><tr><th>Level</th><th>Price</th><th></th></tr></thead><tbody id="fibBody"></tbody></table>
      </div>
    </div>

    <div class="section">
      <h2>News · Analysis · Trader Opinions</h2>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:10px">Quick links — open in new tabs.</p>
      <div class="news-links" id="newsLinks"></div>
      <div style="margin-top:12px;font-size:0.82rem;color:var(--muted)">
        <span class="tag">Tip</span> X search: <code id="xQuery" style="color:var(--blue)">$</code>
      </div>
    </div>

    <div class="section notes">
      <h2>Structure Notes</h2>
      <ul id="notesList"><li>Select a symbol and click Analyze.</li></ul>
    </div>
  </div>

  <div class="disclaimer">
    Educational tool only. Levels and ideas are heuristic. Not financial advice. Data via Twelve Data.
  </div>

<script>
const TD_BASE = "https://api.twelvedata.com";
const FH_BASE = "https://finnhub.io/api/v1";
let chart = null;

// Safe localStorage helpers — avoid SecurityError when page is sandboxed
function safeGet(key) {
  try { return localStorage.getItem(key); } catch (e) { return null; }
}
function safeSet(key, value) {
  try { localStorage.setItem(key, value); } catch (e) { /* ignore in sandbox */ }
}

function getDataSource() {
  return document.getElementById("dataSource")?.value || "twelvedata";
}
function apiKeyStorageKey() {
  return getDataSource() === "finnhub" ? "fh_api_key" : "td_api_key";
}
function loadKeyForSource() {
  const el = document.getElementById("apiKey");
  if (!el) return;
  el.value = safeGet(apiKeyStorageKey()) || "";
  el.placeholder = getDataSource() === "finnhub" ? "Finnhub API key" : "Twelve Data API key";
}
safeSet("data_source", "finnhub");
  const savedSource = "finnhub";
if (savedSource && document.getElementById("dataSource")) {
  document.getElementById("dataSource").value = savedSource;
}
loadKeyForSource();
const apiKeyEl = document.getElementById("apiKey");
if (apiKeyEl) {
  apiKeyEl.addEventListener("change", e => {
    safeSet(apiKeyStorageKey(), e.target.value.trim());
  });
}
const dsEl = document.getElementById("dataSource");
if (dsEl) {
  dsEl.addEventListener("change", () => {
    safeSet("data_source", getDataSource());
    loadKeyForSource();
  });
}

/** Map app symbols to Finnhub format */
function toFinnhubSymbol(symbol) {
  const s = symbol.toUpperCase().trim();
  const map = {
    "XAU/USD": "OANDA:XAU_USD", "XAG/USD": "OANDA:XAG_USD",
    "EUR/USD": "OANDA:EUR_USD", "GBP/USD": "OANDA:GBP_USD", "USD/JPY": "OANDA:USD_JPY",
    "BTC/USD": "BINANCE:BTCUSDT", "ETH/USD": "BINANCE:ETHUSDT",
    "SOL/USD": "BINANCE:SOLUSDT", "XRP/USD": "BINANCE:XRPUSDT",
    "GC=F": "OANDA:XAU_USD"
  };
  if (map[s]) return map[s];
  if (s.includes("/")) {
    const [a, b] = s.split("/");
    if (["BTC","ETH","SOL","XRP","BNB","ADA","DOGE"].includes(a)) return "BINANCE:" + a + (b === "USD" ? "USDT" : b);
    return "OANDA:" + a + "_" + b;
  }
  return s; // US stocks / ETFs as-is
}

function finnhubResolution(interval) {
  return ({ "15min": "15", "1h": "60", "4h": "60", "1day": "D" })[interval] || "D";
}

async function tdFetch(endpoint, params) {
  const key = document.getElementById("apiKey").value.trim();
  if (!key) throw new Error("Please enter your Twelve Data API key");
  params.apikey = key;
  const qs = new URLSearchParams(params).toString();
  const res = await fetch(`${TD_BASE}/${endpoint}?${qs}`);
  const data = await res.json();
  if (data.status === "error" || data.code) throw new Error(data.message || JSON.stringify(data));
  return data;
}

/**
 * Unified OHLC fetch → { values: [{datetime, open, high, low, close}, ...] } ascending
 */
async function fetchOHLC(symbol, interval, outputsize) {
  const source = getDataSource();
  const key = document.getElementById("apiKey").value.trim();
  if (!key) throw new Error("Please enter your API key for " + (source === "finnhub" ? "Finnhub" : "Twelve Data"));

  if (source === "finnhub") {
    const fhSym = toFinnhubSymbol(symbol);
    const resolution = finnhubResolution(interval);
    // 4h: request 60m and aggregate below
    const needAgg4h = interval === "4h";
    const res = needAgg4h ? "60" : resolution;
    const bars = needAgg4h ? Math.max(outputsize * 4, 400) : Math.max(outputsize, 100);
    const to = Math.floor(Date.now() / 1000);
    // rough from: 15m ~ bars*15min, etc.
    const secPerBar = ({ "15": 900, "60": 3600, "D": 86400 })[res] || 86400;
    const from = to - bars * secPerBar - 86400 * 3;
    // FIX: Finnhub has separate endpoints - /stock/candle rejects forex/crypto with "You don't have access to this resource". Route by asset type.
    const isCrypto = ["BTC","ETH","SOL","XRP","BNB","ADA","DOGE"].includes(symbol.split("/")[0]);
    const isForex = symbol.includes("/") && !isCrypto;
    const fhEndpoint = isCrypto ? "crypto/candle" : isForex ? "forex/candle" : "stock/candle";
    const url = `${FH_BASE}/${fhEndpoint}?symbol=${encodeURIComponent(fhSym)}&resolution=${res}&from=${from}&to=${to}&token=${encodeURIComponent(key)}`;
    const r = await fetch(url);
    const data = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(data.error || ("Finnhub HTTP " + r.status + " - check your API key and that this symbol is allowed on your Finnhub plan"));
    if (data.s === "no_data") throw new Error("Symbol not found on Finnhub: " + fhSym);
    if (data.error) throw new Error(data.error);
    if (data.s !== "ok" || !data.c || !data.c.length) throw new Error("Finnhub returned no candle data for " + fhSym);

    let rows = data.t.map((t, i) => ({
      datetime: new Date(t * 1000).toISOString().slice(0, 19).replace("T", " "),
      open: data.o[i], high: data.h[i], low: data.l[i], close: data.c[i]
    }));
    // Aggregate 1h → 4h if needed
    if (needAgg4h) {
      const buckets = new Map();
      rows.forEach(row => {
        const d = new Date(row.datetime + "Z");
        const h = d.getUTCHours();
        const bucketH = Math.floor(h / 4) * 4;
        d.setUTCHours(bucketH, 0, 0, 0);
        const keyB = d.toISOString();
        if (!buckets.has(keyB)) {
          buckets.set(keyB, { datetime: keyB.slice(0, 19).replace("T", " "), open: row.open, high: row.high, low: row.low, close: row.close });
        } else {
          const b = buckets.get(keyB);
          b.high = Math.max(b.high, row.high);
          b.low = Math.min(b.low, row.low);
          b.close = row.close;
        }
      });
      rows = Array.from(buckets.values());
    }
    if (rows.length > outputsize) rows = rows.slice(-outputsize);
    return { values: rows };
  }

  // Twelve Data
  return tdFetch("time_series", { symbol, interval, outputsize, order: "ASC" });
}

// Client-side indicators — saves API credits (no /sma or /rsi endpoints)
function calcSMA(closes, period) {
  if (!closes || closes.length < period) return null;
  let sum = 0;
  for (let i = closes.length - period; i < closes.length; i++) sum += closes[i];
  return sum / period;
}
function calcRSI(closes, period) {
  if (!closes || closes.length < period + 1) return null;
  let gains = 0, losses = 0;
  for (let i = closes.length - period; i < closes.length; i++) {
    const d = closes[i] - closes[i - 1];
    if (d >= 0) gains += d; else losses -= d;
  }
  const ag = gains / period, al = losses / period;
  if (al === 0) return 100;
  const rs = ag / al;
  return 100 - (100 / (1 + rs));
}
function calcRSISeries(closes, period) {
  const out = new Array(closes.length).fill(null);
  if (closes.length < period + 1) return out;
  for (let i = period; i < closes.length; i++) {
    let gains = 0, losses = 0;
    for (let j = i - period + 1; j <= i; j++) {
      const d = closes[j] - closes[j - 1];
      if (d >= 0) gains += d; else losses -= d;
    }
    const ag = gains / period, al = losses / period;
    out[i] = al === 0 ? 100 : 100 - (100 / (1 + ag / al));
  }
  return out;
}
/** Approximate weekly closes from daily (last close each ISO week) */
function weeklyClosesFromDaily(dates, closes) {
  const map = new Map();
  for (let i = 0; i < dates.length; i++) {
    const d = new Date(dates[i]);
    const key = d.getUTCFullYear() + "-W" + Math.ceil((((d - new Date(Date.UTC(d.getUTCFullYear(),0,1))) / 86400000) + 1) / 7);
    map.set(key, closes[i]);
  }
  return Array.from(map.values());
}

function zigzag(highs, lows, closes, dates, threshold = 0.025) {
  const pivots = [];
  let lastPrice = closes[0], lastIdx = 0, trend = 0;
  for (let i = 1; i < closes.length; i++) {
    const up = (highs[i] - lastPrice) / lastPrice;
    const dn = (lastPrice - lows[i]) / lastPrice;
    if (trend >= 0) {
      if (up >= threshold) { lastPrice = highs[i]; lastIdx = i; trend = 1; }
      else if (dn >= threshold) {
        pivots.push({ date: dates[lastIdx], price: lastPrice, type: "H" });
        lastPrice = lows[i]; lastIdx = i; trend = -1;
      }
    } else {
      if (dn >= threshold) { lastPrice = lows[i]; lastIdx = i; trend = -1; }
      else if (up >= threshold) {
        pivots.push({ date: dates[lastIdx], price: lastPrice, type: "L" });
        lastPrice = highs[i]; lastIdx = i; trend = 1;
      }
    }
  }
  if (trend === 1) pivots.push({ date: dates[lastIdx], price: lastPrice, type: "H" });
  else if (trend === -1) pivots.push({ date: dates[lastIdx], price: lastPrice, type: "L" });
  return pivots;
}

/**
 * ICT-style proxy on daily bars:
 * - Sweep: bar trades beyond a prior swing high/low then closes back inside
 * - Displacement: large-range directional bar (body-dominant) after a sweep window
 */
function detectICT(highs, lows, closes, opens, dates, pivots) {
  const n = closes.length;
  const result = {
    sweep: null,
    displacement: null,
    structure: "Neutral",
    note: "No clear daily sweep/displace in the recent window."
  };
  if (n < 10 || pivots.length < 2) return result;

  // Average true range proxy for displacement threshold
  let atrSum = 0, atrN = 0;
  for (let i = Math.max(1, n - 30); i < n; i++) {
    const tr = Math.max(highs[i] - lows[i], Math.abs(highs[i] - closes[i-1]), Math.abs(lows[i] - closes[i-1]));
    atrSum += tr; atrN++;
  }
  const atr = atrN ? atrSum / atrN : closes[n-1] * 0.01;

  // Recent swing highs/lows (last 6 pivots)
  const recent = pivots.slice(-6);
  const swingHighs = recent.filter(p => p.type === "H");
  const swingLows = recent.filter(p => p.type === "L");

  // Scan last ~15 bars for sweep of a prior swing
  const lookback = Math.min(15, n - 2);
  for (let i = n - lookback; i < n; i++) {
    for (const sh of swingHighs) {
      // buy-side liquidity sweep: high beyond swing high, close back below
      if (highs[i] > sh.price && closes[i] < sh.price) {
        result.sweep = {
          side: "buy-side (highs)",
          level: sh.price,
          date: dates[i],
          label: "Sweep of swing high @ " + sh.price.toFixed(2)
        };
      }
    }
    for (const sl of swingLows) {
      // sell-side liquidity sweep: low beyond swing low, close back above
      if (lows[i] < sl.price && closes[i] > sl.price) {
        result.sweep = {
          side: "sell-side (lows)",
          level: sl.price,
          date: dates[i],
          label: "Sweep of swing low @ " + sl.price.toFixed(2)
        };
      }
    }
  }

  // Displacement: last few bars with range > 1.4*ATR and strong body
  for (let i = n - 8; i < n; i++) {
    if (i < 1) continue;
    const range = highs[i] - lows[i];
    const body = Math.abs(closes[i] - opens[i]);
    if (range >= 1.4 * atr && body >= 0.55 * range) {
      const bull = closes[i] > opens[i];
      result.displacement = {
        dir: bull ? "bullish" : "bearish",
        date: dates[i],
        label: (bull ? "Bullish" : "Bearish") + " displacement bar"
      };
    }
  }

  // Structure from last two pivots
  if (pivots.length >= 2) {
    const a = pivots[pivots.length - 2], b = pivots[pivots.length - 1];
    if (b.type === "H" && b.price > a.price) result.structure = "Bullish swing pressure";
    else if (b.type === "L" && b.price < a.price) result.structure = "Bearish swing pressure";
    else result.structure = "Mixed / consolidating";
  }

  // Note
  const parts = [];
  if (result.sweep) parts.push(result.sweep.label + " on " + String(result.sweep.date).slice(0, 10));
  if (result.displacement) parts.push(result.displacement.label + " (" + String(result.displacement.date).slice(0, 10) + ")");
  parts.push(result.structure);
  result.note = parts.join(" · ");
  return result;
}

/** Label map for liquidity levels in structure notes */
const LIQ_LABELS = {
  PDH: "PDH (prev day high)",
  PDL: "PDL (prev day low)",
  Pivot: "P (daily pivot)",
  R1: "R1 (daily pivot resistance)",
  R2: "R2 (daily pivot resistance)",
  S1: "S1 (daily pivot support)",
  S2: "S2 (daily pivot support)"
};

/**
 * Approximate BOS / CHoCH from recent ZigZag pivots + last close.
 * Bullish structure: higher highs + higher lows. Bearish: lower highs + lower lows.
 * CHoCH = first break against that pattern. BOS = continuation break with the pattern.
 */
function detectBOSCHOCH(pivots, price) {
  const out = { event: null, level: null, detail: "No clear BOS/CHoCH yet", biasHint: null };
  if (!pivots || pivots.length < 4) return out;

  const p = pivots.slice(-5);
  // Collect last highs and lows in order
  const highs = p.filter(x => x.type === "H");
  const lows = p.filter(x => x.type === "L");
  if (highs.length < 2 || lows.length < 2) return out;

  const h1 = highs[highs.length - 2].price, h2 = highs[highs.length - 1].price;
  const l1 = lows[lows.length - 2].price, l2 = lows[lows.length - 1].price;
  const lastH = highs[highs.length - 1];
  const lastL = lows[lows.length - 1];

  const bullStruct = h2 > h1 && l2 > l1; // HH + HL
  const bearStruct = h2 < h1 && l2 < l1; // LH + LL

  // Immediate break relative to last opposite swing
  if (bearStruct && price > lastH.price) {
    out.event = "CHoCH";
    out.level = lastH.price;
    out.biasHint = "bullish";
    out.detail = `Bullish CHoCH — broke last lower-high @ ${lastH.price.toFixed(2)} (prior bearish structure)`;
  } else if (bullStruct && price < lastL.price) {
    out.event = "CHoCH";
    out.level = lastL.price;
    out.biasHint = "bearish";
    out.detail = `Bearish CHoCH — broke last higher-low @ ${lastL.price.toFixed(2)} (prior bullish structure)`;
  } else if (bearStruct && price < lastL.price) {
    out.event = "BOS";
    out.level = lastL.price;
    out.biasHint = "bearish";
    out.detail = `Bearish BOS — broke last low @ ${lastL.price.toFixed(2)} (continuation)`;
  } else if (bullStruct && price > lastH.price) {
    out.event = "BOS";
    out.level = lastH.price;
    out.biasHint = "bullish";
    out.detail = `Bullish BOS — broke last high @ ${lastH.price.toFixed(2)} (continuation)`;
  } else if (bearStruct) {
    out.detail = `Bearish structure intact (LH/LL). Watch BOS below ${lastL.price.toFixed(2)} or CHoCH above ${lastH.price.toFixed(2)}`;
    out.biasHint = "bearish";
    out.level = lastL.price;
  } else if (bullStruct) {
    out.detail = `Bullish structure intact (HH/HL). Watch BOS above ${lastH.price.toFixed(2)} or CHoCH below ${lastL.price.toFixed(2)}`;
    out.biasHint = "bullish";
    out.level = lastH.price;
  } else {
    out.detail = "Mixed swings — wait for clearer HH/HL or LH/LL";
  }
  return out;
}

function showError(title, detail) {
  const box = document.getElementById("errorBox");
  document.getElementById("errTitle").textContent = title || "Something went wrong";
  document.getElementById("errDetail").textContent = detail || "";
  box.classList.add("visible");
}
function clearError() {
  document.getElementById("errorBox").classList.remove("visible");
}
function setLoading(isLoading) {
  const btn = document.getElementById("runBtn");
  const overlay = document.getElementById("chartLoading");
  const dash = document.getElementById("dashboard");
  if (isLoading) {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Loading…';
    if (overlay) overlay.classList.remove("hidden");
    dash.classList.add("loading");
  } else {
    btn.disabled = false;
    btn.textContent = "Analyze";
    if (overlay) overlay.classList.add("hidden");
    dash.classList.remove("loading");
  }
}
function friendlyError(err) {
  const msg = (err && err.message) ? err.message : String(err);
  const lower = msg.toLowerCase();
  if (lower.includes("don't have access") || lower.includes("access to this resource")) { return ["Finnhub blocked this symbol on this endpoint", "This was the stock/forex/crypto endpoint bug - now fixed in this version. If it still appears, that symbol needs a paid Finnhub plan. Try AAPL to confirm your key works."]; }
   if (lower.includes("api key") || lower.includes("apikey") || lower.includes("401") || lower.includes("unauthorized") || lower.includes("invalid token")) {
    return ["Invalid or missing API key", "Select a data source and paste the matching key (Twelve Data or Finnhub)."];
  }
  if (lower.includes("429") || lower.includes("rate") || lower.includes("credit") || lower.includes("limit")) {
    return ["Rate limit reached", "Free plans limit requests per minute. Wait ~60 seconds and Retry — or switch data source in the dropdown."];
  }
  if (lower.includes("symbol") || lower.includes("not found") || lower.includes("invalid")) {
    return ["Symbol not found", "Check the ticker spelling. For crypto/forex use formats like BTC/USD or EUR/USD."];
  }
  if (lower.includes("chart") || lower.includes("ad-block") || lower.includes("adblocker")) {
    return ["Chart library failed to load", "Disable any ad-blocker for this page, check your internet, then refresh and try again."];
  }
  if (lower.includes("network") || lower.includes("failed to fetch")) {
    return ["Network error", "Could not reach the data provider. Check your internet connection and try again."];
  }
  return ["Request failed", msg];
}

function getSymbol() {
  const custom = document.getElementById("customSymbol").value.trim().toUpperCase();
  return custom || document.getElementById("symbolSelect").value;
}

function getChartTf() {
  return document.getElementById("tfSelect")?.value || "4h";
}

function tfZigZagThreshold(tf) {
  return ({ "15min": 0.006, "1h": 0.01, "4h": 0.012, "1day": 0.025 })[tf] || 0.015;
}

function tfOutputSize(tf) {
  return ({ "15min": 300, "1h": 250, "4h": 200, "1day": 250 })[tf] || 200;
}

function tfLabel(tf) {
  return ({ "15min": "15m", "1h": "1H", "4h": "4H", "1day": "Daily" })[tf] || tf;
}

function nearestLevel(price, levels) {
  let best = null, bestDist = Infinity;
  for (const [name, val] of Object.entries(levels)) {
    const d = Math.abs(price - val);
    if (d < bestDist) { bestDist = d; best = { name, val }; }
  }
  return best;
}

function lineAnno(y, color, label, dash = false) {
  return {
    type: 'line',
    yMin: y, yMax: y,
    borderColor: color,
    borderWidth: dash ? 1.2 : 2,
    borderDash: dash ? [4, 4] : [],
    label: {
      display: true,
      content: label,
      position: 'end',
      backgroundColor: color + 'cc',
      color: '#fff',
      font: { size: 10, weight: '600' },
      padding: 3
    }
  };
}

async function runAnalysis() {
  const symbol = getSymbol();
  const chartTf = getChartTf();
  clearError();
  setLoading(true);

  try {
    // Credit-saver: only OHLC (1–2 calls). SMA/RSI computed in browser.
    // Provider: Twelve Data or Finnhub (dropdown).
    let tsDaily, tsChart;
    if (chartTf === "1day") {
      tsDaily = await fetchOHLC(symbol, "1day", 250);
      tsChart = tsDaily;
    } else {
      [tsDaily, tsChart] = await Promise.all([
        fetchOHLC(symbol, "1day", 250),
        fetchOHLC(symbol, chartTf, tfOutputSize(chartTf))
      ]);
    }

    // --- Daily (HTF) ---
    const dVals = tsDaily.values;
    const dDates = dVals.map(v => v.datetime);
    const dCloses = dVals.map(v => +v.close);
    const dHighs = dVals.map(v => +v.high);
    const dLows = dVals.map(v => +v.low);

    const sma = calcSMA(dCloses, 200);
    const rsiD = calcRSI(dCloses, 14);
    const rsiW = calcRSI(weeklyClosesFromDaily(dDates, dCloses), 14);

    // --- Chart timeframe ---
    const values = tsChart.values;
    const dates = values.map(v => v.datetime);
    const closes = values.map(v => +v.close);
    const highs = values.map(v => +v.high);
    const lows = values.map(v => +v.low);
    const opens = values.map(v => +v.open);
    const price = closes.at(-1);

    const rsiSeries = calcRSISeries(closes, 14);
    // Flat SMA200 line value for chart (daily HTF level)
    const smaSeries = dates.map(() => sma);

    // PDH/PDL/pivots always from daily bars
    const pdh = dHighs.at(-2), pdl = dLows.at(-2), pdc = dCloses.at(-2);
    const pivot = (pdh + pdl + pdc) / 3;
    const r1 = 2 * pivot - pdl, s1 = 2 * pivot - pdh;
    const r2 = pivot + (pdh - pdl), s2 = pivot - (pdh - pdl);
    const liqLevels = { PDH: pdh, PDL: pdl, Pivot: pivot, R1: r1, R2: r2, S1: s1, S2: s2 };
    const near = nearestLevel(price, liqLevels);

    document.getElementById("pdh").textContent = pdh.toFixed(2);
    document.getElementById("pdl").textContent = pdl.toFixed(2);
    document.getElementById("pivot").textContent = pivot.toFixed(2);
    document.getElementById("r1").textContent = r1.toFixed(2);
    document.getElementById("r2").textContent = r2.toFixed(2);
    document.getElementById("s1").textContent = s1.toFixed(2);
    document.getElementById("s2").textContent = s2.toFixed(2);
    document.getElementById("nearestLiq").textContent = near ? `${near.name} (${near.val.toFixed(2)})` : "—";

    let bias = "NEUTRAL", biasClass = "bias-neutral";
    if (sma != null && price > sma && (rsiW == null || rsiW < 68)) { bias = "LONG preferred"; biasClass = "bias-long"; }
    else if (sma != null && price < sma && (rsiW == null || rsiW > 32)) { bias = "SHORT preferred"; biasClass = "bias-short"; }

    document.getElementById("price").textContent = price.toFixed(2);
    document.getElementById("priceSub").textContent = symbol + " · " + tfLabel(chartTf);
    document.getElementById("sma").textContent = sma != null ? sma.toFixed(2) : "—";
    document.getElementById("sma").style.color = sma != null && price > sma ? "var(--green)" : "var(--red)";
    document.getElementById("smaSub").innerHTML = sma != null ? (`Price is <strong>${price > sma ? "ABOVE" : "BELOW"}</strong>`) : "Need more history";
    document.getElementById("rsiD").textContent = rsiD != null ? rsiD.toFixed(1) : "—";
    document.getElementById("rsiDSub").textContent = rsiD == null ? "—" : (rsiD > 70 ? "Overbought" : (rsiD < 30 ? "Oversold" : "Neutral"));
    document.getElementById("rsiW").textContent = rsiW != null ? rsiW.toFixed(1) : "—";
    const biasEl = document.getElementById("bias");
    biasEl.textContent = bias; biasEl.className = "bias-pill " + biasClass;

    const pivotsZ = zigzag(highs, lows, closes, dates, tfZigZagThreshold(chartTf));
    document.getElementById("pivotBody").innerHTML = pivotsZ.slice(-8).map(p =>
      `<tr><td>${String(p.date).slice(0,16)}</td><td style="color:${p.type==='H'?'var(--green)':'var(--red)'};font-weight:600">${p.type}</td><td>${p.price.toFixed(2)}</td></tr>`
    ).join("");

    // ICT on the selected chart timeframe
    const ict = detectICT(highs, lows, closes, opens, dates, pivotsZ);
    const ictHeading = document.querySelector("#dashboard .section h2");
    // update ICT section title if present
    document.querySelectorAll("#dashboard .section h2").forEach(h => {
      if (h.textContent.includes("ICT")) h.textContent = "ICT-style context (" + tfLabel(chartTf) + ")";
    });
    document.querySelectorAll("#dashboard .liq-item label").forEach(lab => {
      if (lab.textContent.includes("sweep")) lab.textContent = "Last sweep (" + tfLabel(chartTf) + ")";
      if (lab.textContent.includes("Displacement")) lab.textContent = "Displacement (" + tfLabel(chartTf) + ")";
      if (lab.textContent.includes("Structure")) lab.textContent = "Structure (" + tfLabel(chartTf) + ")";
    });
    document.getElementById("ictSweep").textContent = ict.sweep ? ict.sweep.label : "None recent";
    document.getElementById("ictDisp").textContent = ict.displacement ? ict.displacement.label : "None recent";
    document.getElementById("ictStruct").textContent = ict.structure;
    let ictAlign = "Neutral";
    let ictAlignColor = "var(--muted)";
    if (bias === "LONG preferred" && ict.displacement && ict.displacement.dir === "bullish") {
      ictAlign = "Supports longs"; ictAlignColor = "var(--green)";
    } else if (bias === "SHORT preferred" && ict.displacement && ict.displacement.dir === "bearish") {
      ictAlign = "Supports shorts"; ictAlignColor = "var(--green)";
    } else if (bias === "LONG preferred" && ict.displacement && ict.displacement.dir === "bearish") {
      ictAlign = "Counter-bias risk"; ictAlignColor = "var(--red)";
    } else if (bias === "SHORT preferred" && ict.displacement && ict.displacement.dir === "bullish") {
      ictAlign = "Counter-bias risk"; ictAlignColor = "var(--red)";
    } else if (ict.sweep && !ict.displacement) {
      ictAlign = "Sweep only — wait displace"; ictAlignColor = "var(--orange)";
    }
    const alignEl = document.getElementById("ictAlign");
    alignEl.textContent = ictAlign;
    alignEl.style.color = ictAlignColor;
    document.getElementById("ictNote").textContent = tfLabel(chartTf) + ": " + ict.note + " · Confirm precise entries on TradingView.";

    let entry="—", stop="—", t1="—", t2="—", rr="—", direction="No clear setup", aiText="";
    let entryLo=null, entryHi=null, stopVal=null, t1Val=null, t2Val=null;
    let notes = [];

    if (pivotsZ.length >= 2) {
      const last = pivotsZ.at(-1), prev = pivotsZ.at(-2);
      const start = prev.price, end = last.price, diff = end - start;
      const levels = {
        "0.0": end, "0.236": end-0.236*diff, "0.382": end-0.382*diff,
        "0.5": end-0.5*diff, "0.618": end-0.618*diff, "0.786": end-0.786*diff, "1.0": start
      };
      document.getElementById("fibBody").innerHTML = Object.entries(levels).map(([lvl,val]) => {
        const nearFib = Math.abs(val-price)/price < 0.01;
        return `<tr style="${nearFib?'background:#1f6feb33':''}"><td>${lvl}</td><td>${val.toFixed(2)}</td><td>${nearFib?'← near':''}</td></tr>`;
      }).join("");

      const bos = detectBOSCHOCH(pivotsZ, price);

      notes.push(`Last swing: <strong>${last.type}</strong> @ ${last.price.toFixed(2)}`);
      if (near) {
        const nice = LIQ_LABELS[near.name] || near.name;
        notes.push(`Nearest liquidity: <strong>${nice} @ ${near.val.toFixed(2)}</strong>`);
      } else {
        notes.push("Nearest liquidity: n/a");
      }
      notes.push(`Structure: <strong>${bos.detail}</strong>`);
      notes.push(
        `Daily pivots — P ${pivot.toFixed(2)} · R1 ${r1.toFixed(2)} · S1 ${s1.toFixed(2)} · PDH ${pdh.toFixed(2)} · PDL ${pdl.toFixed(2)}`
      );

      const isUp = last.type === "H";
      const fib382 = levels["0.382"], fib50 = levels["0.5"], fib786 = levels["0.786"];

      // Prefer BOS/CHoCH-aligned entry advice when event is fresh / relevant
      const bosLong = bos.event && bos.biasHint === "bullish";
      const bosShort = bos.event && bos.biasHint === "bearish";
      const bosPendingBear = !bos.event && bos.biasHint === "bearish";
      const bosPendingBull = !bos.event && bos.biasHint === "bullish";

      if (bosLong && bias === "LONG preferred") {
        direction = bos.event === "CHoCH" ? "LONG — Bullish CHoCH" : "LONG — Bullish BOS";
        entryLo = price * 0.998; entryHi = price * 1.002;
        entry = `On/after ${bos.event} hold above ${bos.level.toFixed(2)}`;
        stopVal = Math.min(fib786, pdl, bos.level) * 0.997;
        stop = stopVal.toFixed(2);
        t1Val = Math.max(end, pdh, r1);
        t1 = t1Val.toFixed(2);
        t2Val = t1Val + Math.abs(diff) * 0.5;
        t2 = t2Val.toFixed(2);
        rr = "—";
        aiText = `${bos.detail}. HTF bias is long. Entry style: wait for small pullback/retest of the break level ${bos.level.toFixed(2)} or continuation only if displacement holds. Stop below structure (~${stop}). Targets ~${t1} / ${t2}.`;
      }
      else if (bosShort && bias === "SHORT preferred") {
        direction = bos.event === "CHoCH" ? "SHORT — Bearish CHoCH" : "SHORT — Bearish BOS";
        entryLo = price * 0.998; entryHi = price * 1.002;
        entry = `On/after ${bos.event} hold below ${bos.level.toFixed(2)}`;
        stopVal = Math.max(fib786, pdh, bos.level) * 1.003;
        stop = stopVal.toFixed(2);
        t1Val = Math.min(end, pdl, s1);
        t1 = t1Val.toFixed(2);
        t2Val = t1Val - Math.abs(diff) * 0.5;
        t2 = t2Val.toFixed(2);
        rr = "—";
        aiText = `${bos.detail}. HTF bias is short. Entry style: wait for weak rally/retest into the break level ${bos.level.toFixed(2)} or continuation if displacement holds. Stop above structure (~${stop}). Targets ~${t1} / ${t2}.`;
      }
      else if (bosLong && bias !== "LONG preferred") {
        direction = "Bullish " + bos.event + " — counter HTF caution";
        aiText = `${bos.detail}. But HTF bias is not long — treat as counter-trend. Prefer wait for HTF alignment or use only as a scalp with tight risk.`;
        entry = `Retest of ${bos.level.toFixed(2)} (caution)`;
        stopVal = bos.level * 0.99; stop = stopVal.toFixed(2);
      }
      else if (bosShort && bias !== "SHORT preferred") {
        direction = "Bearish " + bos.event + " — counter HTF caution";
        aiText = `${bos.detail}. But HTF bias is not short — treat as counter-trend. Prefer wait for HTF alignment or tight risk only.`;
        entry = `Retest of ${bos.level.toFixed(2)} (caution)`;
        stopVal = bos.level * 1.01; stop = stopVal.toFixed(2);
      }
      else if (bias === "LONG preferred" && isUp) {
        direction = "LONG — Pullback into value";
        entryLo = Math.min(fib382, fib50); entryHi = Math.max(fib382, fib50);
        entry = `${entryLo.toFixed(2)} – ${entryHi.toFixed(2)}`;
        stopVal = Math.min(fib786, pdl) * 0.997;
        stop = stopVal.toFixed(2);
        t1Val = Math.max(end, pdh, r1);
        t1 = t1Val.toFixed(2);
        t2Val = end + diff * 0.618;
        t2 = t2Val.toFixed(2);
        const risk = entryHi - stopVal, reward = t1Val - entryHi;
        rr = risk > 0 ? (reward/risk).toFixed(1)+" : 1" : "—";
        aiText = `Long bias, no fresh BOS/CHoCH yet. ${bos.detail}. Prefer pullback into ${entry}, or wait for bullish BOS/CHoCH for momentum entry. Stop ~${stop}. T1/T2 ~${t1} / ${t2}.`;
      }
      else if (bias === "SHORT preferred" && !isUp) {
        direction = "SHORT — Bounce into value";
        entryLo = Math.min(fib382, fib50); entryHi = Math.max(fib382, fib50);
        entry = `${entryLo.toFixed(2)} – ${entryHi.toFixed(2)}`;
        stopVal = Math.max(fib786, pdh) * 1.003;
        stop = stopVal.toFixed(2);
        t1Val = Math.min(end, pdl, s1);
        t1 = t1Val.toFixed(2);
        t2Val = end - Math.abs(diff) * 0.618;
        t2 = t2Val.toFixed(2);
        const risk = stopVal - entryLo, reward = entryLo - t1Val;
        rr = risk > 0 ? (reward/risk).toFixed(1)+" : 1" : "—";
        aiText = `Short bias, no fresh BOS/CHoCH yet. ${bos.detail}. Prefer bounce into ${entry}, or wait for bearish BOS/CHoCH for momentum entry. Stop ~${stop}. T1/T2 ~${t1} / ${t2}.`;
      }
      else if (bias === "LONG preferred") {
        direction = bosPendingBull ? "LONG bias — wait BOS/CHoCH" : "LONG bias — watch corrective low";
        entryLo = last.price * 0.995; entryHi = last.price * 1.005;
        entry = `Near ${last.price.toFixed(2)} or on bullish BOS/CHoCH`;
        stopVal = Math.min(last.price, pdl) * 0.985;
        stop = stopVal.toFixed(2);
        t1Val = Math.max(prev.price, pivot, r1);
        t1 = t1Val.toFixed(2);
        t2Val = t1Val + Math.abs(prev.price - last.price) * 0.5;
        t2 = t2Val.toFixed(2);
        aiText = `Long HTF. ${bos.detail}. Prefer entry after bullish CHoCH/BOS or a higher-low hold. Invalidation below ~${stop}.`;
      }
      else if (bias === "SHORT preferred") {
        direction = bosPendingBear ? "SHORT bias — wait BOS/CHoCH" : "SHORT bias — watch corrective high";
        entryLo = last.price * 0.995; entryHi = last.price * 1.005;
        entry = `Near ${last.price.toFixed(2)} or on bearish BOS/CHoCH`;
        stopVal = Math.max(last.price, pdh) * 1.015;
        stop = stopVal.toFixed(2);
        t1Val = Math.min(prev.price, pivot, s1);
        t1 = t1Val.toFixed(2);
        t2Val = t1Val - Math.abs(last.price - prev.price) * 0.5;
        t2 = t2Val.toFixed(2);
        aiText = `Short HTF. ${bos.detail}. Prefer entry after bearish CHoCH/BOS or a lower-high rejection. Invalidation above ~${stop}.`;
      }
      else {
        aiText = `No strong HTF alignment. ${bos.detail}. Nearest liquidity: ${near ? (LIQ_LABELS[near.name] || near.name) + " @ " + near.val.toFixed(2) : "n/a"}.`;
      }

      // Soft ICT filter note on the idea
      if (ictAlign === "Counter-bias risk") {
        aiText += " ⚠ Displacement is against HTF bias — lower quality (like TV NO TRADE: COUNTER-BIAS).";
        direction = direction + " (counter-ICT caution)";
      } else if (ictAlign === "Supports longs" || ictAlign === "Supports shorts") {
        aiText += " ICT sweep/displace proxy aligns with HTF bias.";
      } else if (ict.sweep && !ict.displacement) {
        aiText += " Sweep seen but no clear displacement yet — wait for impulsive follow-through before entry.";
      }
      notes.push("ICT: " + ict.note);
    } else {
      document.getElementById("fibBody").innerHTML = "<tr><td colspan='3'>Not enough swings</td></tr>";
      aiText = "Insufficient swing data.";
    }

    document.getElementById("tradeDirection").textContent = direction;
    document.getElementById("entryZone").textContent = entry;
    document.getElementById("stopLevel").textContent = stop;
    document.getElementById("target1").textContent = t1;
    document.getElementById("target2").textContent = t2;
    document.getElementById("rrRatio").textContent = rr;
    document.getElementById("aiIdea").textContent = aiText;
    document.getElementById("notesList").innerHTML = notes.map(n => `<li>${n}</li>`).join("") || "<li>—</li>";

    const symClean = symbol.replace("/","");
    document.getElementById("newsLinks").innerHTML = `
      <a href="https://finance.yahoo.com/quote/${encodeURIComponent(symbol)}/news" target="_blank" rel="noopener">Yahoo News</a>
      <a href="https://www.google.com/search?q=${encodeURIComponent(symbol+' stock news')}&tbm=nws" target="_blank" rel="noopener">Google News</a>
      <a href="https://www.tradingview.com/symbols/${encodeURIComponent(symClean)}/ideas/" target="_blank" rel="noopener">TradingView Ideas</a>
      <a href="https://twitter.com/search?q=%24${encodeURIComponent(symClean)}%20(swing%20OR%20%22technical%20analysis%22)&src=typed_query&f=live" target="_blank" rel="noopener">X Live</a>
      <a href="https://finviz.com/quote.ashx?t=${encodeURIComponent(symClean)}" target="_blank" rel="noopener">Finviz</a>
      <a href="https://pipatlas.com/" target="_blank" rel="noopener">Econ Calendar</a>`;
    document.getElementById("xQuery").textContent = "$" + symClean + " swing OR technical";

    // ===== CHART WITH ANNOTATIONS =====
    const slice = 120;
    const cDates = dates.slice(-slice);
    const cClose = closes.slice(-slice);
    const cSma = smaSeries.slice(-slice);
    const cRsi = rsiSeries.slice(-slice);

    const annotations = {};
    // Liquidity (dashed, muted)
    annotations.pdh = lineAnno(pdh, '#8b949e', 'PDH', true);
    annotations.pdl = lineAnno(pdl, '#8b949e', 'PDL', true);
    annotations.pivot = lineAnno(pivot, '#8b949e', 'Pivot', true);

    // Trade levels (solid, colored)
    if (entryLo != null && entryHi != null) {
      annotations.entryLo = lineAnno(entryLo, '#58a6ff', 'Entry L');
      annotations.entryHi = lineAnno(entryHi, '#58a6ff', 'Entry H');
    }
    if (stopVal != null) annotations.stop = lineAnno(stopVal, '#f85149', 'Stop');
    if (t1Val != null) annotations.t1 = lineAnno(t1Val, '#3fb950', 'T1');
    if (t2Val != null) annotations.t2 = lineAnno(t2Val, '#3fb950', 'T2');

    // Buy / Sell arrow near the latest price
    const isLong = direction.toUpperCase().includes("LONG");
    const isShort = direction.toUpperCase().includes("SHORT");
    if (isLong || isShort) {
      const arrowY = isLong ? (entryHi != null ? entryHi : price) : (entryLo != null ? entryLo : price);
      const arrowColor = isLong ? '#3fb950' : '#f85149';
      const arrowLabel = isLong ? '▲ BUY' : '▼ SELL';
      annotations.signalArrow = {
        type: 'label',
        xValue: cDates[cDates.length - 1],
        yValue: arrowY,
        content: [arrowLabel],
        backgroundColor: arrowColor,
        color: '#ffffff',
        font: { size: 13, weight: 'bold' },
        padding: { top: 6, bottom: 6, left: 10, right: 10 },
        borderRadius: 6,
        position: 'center',
        yAdjust: isLong ? -28 : 28
      };
    }

    function buildChart() {
      if (typeof Chart === 'undefined') {
        throw new Error("Chart library failed to load. Check your network or ad-blocker, then refresh the page.");
      }
      if (chart) chart.destroy();
      chart = new Chart(document.getElementById("mainChart").getContext("2d"), {
        type: "line",
        data: {
          labels: cDates,
          datasets: [
            { label: "Close", data: cClose, borderColor: "#58a6ff", borderWidth: 2, pointRadius: 0, yAxisID: "y" },
            { label: "SMA 200", data: cSma, borderColor: "#f0883e", borderWidth: 1.5, borderDash: [5,4], pointRadius: 0, yAxisID: "y" },
            { label: "RSI", data: cRsi, borderColor: "#a371f7", borderWidth: 1.5, pointRadius: 0, yAxisID: "y1" }
          ]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { labels: { color: "#8b949e" } },
            title: { display: true, text: symbol + " · " + tfLabel(chartTf) + " — Price + Idea Levels", color: "#e6edf3", font: { size: 13 } },
            annotation: { annotations }
          },
          scales: {
            x: { ticks: { color: "#8b949e", maxTicksLimit: 9 }, grid: { color: "#21262d" } },
            y: { position: "left", ticks: { color: "#8b949e" }, grid: { color: "#21262d" } },
            y1: { position: "right", min: 0, max: 100, ticks: { color: "#a371f7" }, grid: { drawOnChartArea: false } }
          }
        }
      });
    }

    if (typeof Chart !== 'undefined') {
      buildChart();
    } else if (typeof window.__ensureChart === 'function') {
      await new Promise(function(resolve, reject) {
        window.__ensureChart(function(err) {
          if (err) reject(err);
          else { try { buildChart(); resolve(); } catch (e) { reject(e); } }
        });
      });
    } else {
      throw new Error("Chart library failed to load. Disable ad-block for this site and refresh.");
    }

    const srcLabel = getDataSource() === "finnhub" ? "Finnhub" : "Twelve Data";
    document.getElementById("timestamp").innerHTML = '<span class="status-ok">Updated: ' + new Date().toISOString().slice(0,16).replace("T"," ") + " UTC  ·  " + symbol + " · " + tfLabel(chartTf) + " · " + srcLabel + "</span>";
    document.getElementById("dashboard").classList.remove("loading");

  } catch (err) {
    console.error(err);
    const [title, detail] = friendlyError(err);
    showError(title, detail);
    document.getElementById("timestamp").innerHTML = '<span class="status-err">Error — see message above</span>';
  } finally {
    setLoading(false);
  }
}


// ===== FINNHUB CONNECTION TEST =====
// Proves in 2 seconds whether the key + Finnhub is reachable,
// without loading the whole dashboard. Uses /quote (free, always allowed).
async function testConnection() {
  const el = document.getElementById("connStatus");
  const key = document.getElementById("apiKey").value.trim();
  if (!key) { el.textContent = "⚠️ Paste your Finnhub key first"; el.style.color = "#f0883e"; return; }
  el.textContent = "⏳ Testing Finnhub..."; el.style.color = "#8b949e";
  try {
    const r = await fetch(`${FH_BASE}/quote?symbol=AAPL&token=${encodeURIComponent(key)}`);
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || ("HTTP " + r.status));
    if (d.error) throw new Error(d.error);
    if (d.c == null) throw new Error("Finnhub returned no price — key may be wrong");
    el.textContent = "✅ Connected! Finnhub is working — AAPL = " + d.c;
    el.style.color = "#3fb950";
  } catch (e) {
    el.textContent = "❌ Not connected: " + e.message;
    el.style.color = "#f85149";
  }
}

if (savedKey) setTimeout(() => runAnalysis(), 500);
</script>
</body>
</html>
